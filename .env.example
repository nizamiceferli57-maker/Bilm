# Bunu .env adı ilə kopyalayıb doldurun.

# ---------------- Telegram ----------------
# @BotFather-dən token
TELEGRAM_BOT_TOKEN=
# Sizin şəxsi Telegram ID-niz (@userinfobot-a yazıb öyrənin). Bot YALNIZ bu ID-yə cavab verir.
TELEGRAM_CHAT_ID=
# İstəyə bağlı: bir neçə admin (vergüllə). Boşdursa TELEGRAM_CHAT_ID istifadə olunur.
ADMIN_IDS=
# İstəyə bağlı: kanallar (@kanal və ya -100...). Əsasən Telegram-dan /kanal_elave ilə əlavə edilir.
CHANNEL_IDS=
# Ara hesabat intervalı (saniyə). Telegram-dan /hesabat_vaxt ilə də dəyişir (0 = söndür)
TELEGRAM_REPORT_EVERY=300
# Canlı panelin yenilənmə intervalı (saniyə)
PANEL_REFRESH=15
# 1 = bot açılan kimi skan başlasın; 0 = gözləsin, Telegram-dan /baslat yazın
AUTO_START=1
# 1 = skan bitəndə proses çıxsın; 0 = bot açıq qalsın və Telegram əmrlərini gözləsin
EXIT_WHEN_DONE=0

USERS_FILE=users.txt

# ---------------- Skan ----------------
# Sürət artıq Telegram-dan idarə olunur (/surat) və yadda qalır. Əvvəlcədən seçilməyibsə,
# loqda blok vermədən işləyən "Normal" sürət istifadə olunur (1 paralel, 1.2s).
# Maksimum paralel say (/surat ilə çıxıla bilən yuxarı hədd, hər kanalda)
SCAN_WORKER_CAP=6
# 0 = hər başlanğıcda siyahı sıfırdan yoxlanır. 1 = qaldığı yerdən davam (və ya: python main.py --resume)
SCAN_RESUME=0
# TikTok 403/429 verəndə gözləmə (saniyə)
BLOCK_BACKOFF=60
SCAN_RECOVER_AFTER=0

# ---------------- Sandıq ----------------
# Eyni anda neçə yayımı dinləmək. Dinləmə müddəti Telegram-dan (/dinleme) dəyişir.
CHEST_CONCURRENCY=3
CHEST_LISTEN_SECONDS=20
CHEST_NOTIFY_MAX=5
# /yoxla ad və ya ad yazanda: sandıq görünmürsə neçə saniyə sonra bitsin (əvvəl 8 idi)
QUICK_IDLE=20
# Sandıq çıxan yayımda davamlı qal (eyni anda maksimum say, saat). 0 = söndür
HOT_MAX=15
HOT_HOURS=3
# 18+ yayımlar üçün öz TikTok hesabınızın cookie-ləri (tiktok.com → F12 → Application → Cookies).
# HƏR İKİSİ lazımdır: SESSION_ID ('sessionid' cookie-si) və TT_TARGET_IDC ('tt-target-idc' cookie-si, məs. alisg / useast2a / maliva / eu-ttp2).
# TT_TARGET_IDC boşdursa sessiya istifadə olunmur (v11 bunu loqda və /yoxla cavabında xəbər verir). Gizli saxlayın.
SESSION_ID=
TT_TARGET_IDC=
# /yoxla ad: yayım canlıdırsa bu qədər dəqiqə yayımda qal (qoşulandan SONRA qoyulan sandıq tutulsun). 0 = söndür
MANUAL_WATCH_MIN=10
# Təcrübə: SESSION_ID ilə "mobile" yazın, qoşulanda əvvəlki sandıq gələ bilər (təsdiqlənməyib). Defolt: web
WS_PLATFORM=web
# Sandıq səviyyələri (ratio = jeton/nəfər): ≥ RATIO_GREAT 💎 ƏLA, ≥ RATIO_GOOD 🔥 YAXŞI
RATIO_GREAT=2.0
RATIO_GOOD=1.0

# ---------------- Proxy (istəyə bağlı) ----------------
# http://user:pass@host:port (və ya socks5://...)
PROXY_URL=
# Bir neçə proxy: vergüllə ayırın və ya proxies.txt faylına hər sətirdə bir proxy yazın.
PROXY_URLS=

# ---------------- Gücləndirilmiş skaner ----------------
SCAN_TIMEOUT=12
SCAN_NAME_ATTEMPTS=3
SCAN_RETRY_ROUNDS=3
SCAN_ROUND_PAUSE=30
BLOCK_BACKOFF_MAX=600

# ---------------- Euler Stream API ----------------
# https://www.eulerstream.com saytından API açarı. Boş qalsa, Euler yoxlaması söndürülür.
EULER_API_KEY=
EULER_VERIFY_LIVE=0
EULER_CONCURRENCY=3
EULER_VERIFY_BUDGET=800
EULER_TIMEOUT=15

# ---------------- ORDU (v13): API-siz, çoxlu işçi ----------------
# EULER_API_KEY boş qalsın: skan PirateTok ilə, qoşulma PirateTok ilə (imza serveri yoxdur)
FLEET=1
# bir IP (proxy) eyni anda neçə canlı saxlasın. 1000 canlı / 25 = ~40 proxy
FLEET_PER_IP=8
FLEET_MAX_LIVES=3000
FLEET_TARGET_LIVES=3000
FLEET_START_DELAY=0.25
FLEET_PROXY_MAX_FAILS=2
FLEET_PROXY_COOLDOWN=600
FLEET_GIVEUP_AFTER=6
# 1: siyahı dövrü təkrar yoxlanır, yeni canlı tapılan kimi ordu ona qoşulur
CONTINUOUS=1
RESCAN_PAUSE=20

# Proxy YOXDURSA: tək IP-də max canlı (çox yüksək etməyin, TikTok bloklaya bilər)
FLEET_DIRECT_CAP=3000
# Bir neçə serverdə paralel işlədəndə: yalnız BİR nüsxədə 1, qalanlarında 0 (eyni bot tokeni ilə ikinci idarə botu 409 xətası verir)
ADMIN_BOT=1

# Qoşulma mühərriki: piratetok = API/imza YOXDUR (defolt). tiktoklive = Euler imzası ilə (EULER_API_KEY lazımdır, hər qoşulma 1-2 sorğu)
FLEET_ENGINE=piratetok
# tiktoklive mühərrikində otaq məlumatı yoxlama aralığı (saniyə). Euler sorğusunu qorumaq üçün 600
REPROBE_EVERY=600

# ---------------- Tək IP ilə çox canlı (planşet/telefon, proxy yoxdur) ----------------
# Proxy YOXDURSA tək IP-də max canlı; qoşulmalar arası fasilə (blok olsa özü artır, uğurda azalır)
FLEET_DIRECT_START_DELAY=2.0
# /izle siyahısındakı hesabların yoxlama aralığı (saniyə)
WATCH_EVERY=45

# ---------------- ttwid paylaşımı (v13.1) ----------------
# Bir ttwid neçə qoşulma arasında bölüşülür; uğursuz olanda IP-ni yormamaq üçün soyuma tətbiq olunur
TTWID_REUSE=150
TTWID_ATTEMPTS=3
TTWID_RETRY_DELAY=1.5
TTWID_FAIL_COOLDOWN=30

# ---------------- Proxy rejimi (v13.2) ----------------
# all (defolt): bütün proxy-lər BİRDƏN işləyir, canlılar və skan onlar arasında bölünür; öz IP işlənmir
# fallback: əsas = öz IP; proxy-lər yalnız öz IP bloklananda işləyir, bərpa olanda geri qayıdır
PROXY_MODE=fallback
# Pulsuz proxy-lərdə bir proxy-yə çox canlı yükləməyin: 8-10 yaxşıdır (25 defoltdur, ödənişli proxy üçün)
# FLEET_PER_IP=10

# 1 (defolt): canlılar proxy-lər arasında bərabər bölünür. 0: işləyən proxy-lər əvvəl dolur
FLEET_BALANCE=1


# ---------------- v13.3: öz IP əsas, blokda gözləyir, proxy ehtiyat ----------------
FLEET_DIRECT_MAX_FAILS=3
FLEET_DIRECT_COOLDOWN=90
SCAN_START_WORKERS=1
SCAN_SPACING=1.5
# fallback rejimi: öz IP əsas heyət, proxy-lər ehtiyat
# öz IP-nin qoşulma növbəsi bu qədər saniyədən uzundursa yeni canlı ehtiyat proxy-yə gedir
FLEET_DIRECT_QUEUE_MAX=8
# öz IP bərpa olanda proxy-dəki canlıları geri köçürmə: neçə saniyədən bir / hər dəfə ən çox neçə canlı
FLEET_REBALANCE_EVERY=15
FLEET_REBALANCE_BATCH=6

# "yayım bitib" cavabı bu qədər dəfə təsdiqlənməyincə canlı atılmır (proxy yalan cavab verə bilər)
FLEET_ENDED_VOTES=2

# Lucky Bag (hediyye cantasi): shortTouch / ecShortItemRefresh hadiseleri
LUCKYBAG=1
# 1: kanallara da gonder (defolt 0: yalniz admin)
LUCKYBAG_CHANNELS=0

# Qosulma sureti: eyni anda en cox nece canliya qosulma cehdi
FLEET_CONNECT_PARALLEL=40

# ---------------- v14 TURBO ----------------
PROXY_MODE=all
INCLUDE_DIRECT=1
FLEET_PER_IP=12
FLEET_PER_IP_PREMIUM=150
FLEET_DIRECT_SHARE=3000
FLEET_PER_PROXY_CONNECT=4
SCAN_PER_LANE=20
SCAN_WORKER_CAP=20
SCAN_MAX_PARALLEL=400
SCAN_RECOVER_AFTER=30
EXECUTOR_THREADS=500
VIEWERS_TIMEOUT=4
